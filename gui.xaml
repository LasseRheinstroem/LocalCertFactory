<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalCertFactory - PKI Manager" Height="870" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E1DFDD"/>
            <Setter Property="Foreground" Value="#323130"/>
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HAUPT TAB CONTROL -->
        <TabControl x:Name="MainTabControl" Grid.Row="0" BorderThickness="0" Background="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- TAB 1: DASHBOARD -->
            <TabItem x:Name="TabDashboard">
                <Grid VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CA STATUS CONTAINER -->
                    <Border Grid.Row="0" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CA-Infrastruktur Status" FontSize="16" FontWeight="Bold" Foreground="#323130"/>
                                <StackPanel x:Name="PanelCaDetails" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Root-CA: " FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtRootCaInfo" Text="-" FontSize="13"/>
                                        <TextBlock x:Name="TxtRootCaExpiry" Text="" FontSize="13" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Intermediate-CA: " FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtInterCaInfo" Text="Nicht vorhanden" FontSize="13"/>
                                        <TextBlock x:Name="TxtInterCaExpiry" Text="" FontSize="13" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtSignModeInfo" Text="Aktiv signierende CA: Root-CA" FontSize="13" FontWeight="SemiBold" Foreground="#0078D4" Margin="0,2"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCaMissing" Text="Keine aktive Root-CA gefunden!" Foreground="#D13438" FontWeight="Bold" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnRenewRootCA" Content="🔄 Root-CA Erneuern" Style="{StaticResource OutlineButton}" Visibility="Collapsed"/>
                                <Button x:Name="BtnShowCreateRootCA" Content="➕ Root-CA Anlegen" Visibility="Collapsed"/>
                                <Button x:Name="BtnRenewIntermediate" Content="🔄 Interm.-CA Erneuern" Style="{StaticResource OutlineButton}" Visibility="Collapsed"/>
                                <Button x:Name="BtnShowCreateIntermediate" Content="➕ Intermediate-CA Anlegen" Style="{StaticResource OutlineButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- SERVICE ZERTIFIKATE LISTE -->
                    <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="15" VerticalAlignment="Stretch">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.1"/>
                        </Border.Effect>
                        <Grid VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Service-Zertifikate Übersicht" FontSize="16" FontWeight="Bold" Foreground="#323130" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnNewService" Content="➕ Neues Zertifikat erstellen"/>
                                    <Button x:Name="BtnRenewDue" Content="🔄 Alle fälligen erneuern / reparieren" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="GridServices" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" 
                                      Background="White" BorderBrush="#E1DFDD" VerticalAlignment="Stretch" SelectionMode="Single">
                                <DataGrid.ContextMenu>
                                    <ContextMenu x:Name="ServiceContextMenu">
                                        <!-- NEU: Globale Aktionen oben im Kontextmenü -->
                                        <MenuItem x:Name="MenuGlobalNewService" Header="Neues Service-Zertifikat erstellen" Icon="➕" />
                                        <MenuItem x:Name="MenuGlobalRenewDue" Header="Alle fälligen erneuern / reparieren" Icon="🔄" />
                                        <Separator />
                                        <!-- Dynamischer Haupt-Aktionspunkt -->
                                        <MenuItem x:Name="MenuMainAction" Header="Verarbeiten" FontWeight="Bold" Icon="🔄" />
                                        <MenuItem x:Name="MenuShowDetails" Header="Details anzeigen" Icon="🔍" />
                                        <!-- Export Untermenü -->
                                        <MenuItem x:Name="MenuExportCustom" Header="In anderem Format exportieren..." Icon="📤" />
                                        <Separator />
                                        <!-- Spezialaktion für Orphans -->
                                        <MenuItem x:Name="MenuAdoptOrphan" Header="In config.yaml übernehmen" Icon="📥" />
                                        <Separator />
                                        <!-- Löschen -->
                                        <MenuItem x:Name="MenuDeleteCert" Header="Zertifikat vollständig löschen" Foreground="Red" Icon="🗑️" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="2*"/>
                                    <DataGridTextColumn Header="CN / SANs (DNS &amp; IPs)" Binding="{Binding SANs}" Width="4*" />
                                    <DataGridTextColumn Header="Verwendung (EKU)" Binding="{Binding EKU}" Width="3*" />
                                    <DataGridTemplateColumn Header="Status" Width="1*">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Gültig bis" Width="1*">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ExpiryDate}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Resttage" Width="0.75*">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DaysRemaining}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: ROOT-CA ANLEGEN -->
            <TabItem x:Name="TabCreateRootCA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="White" CornerRadius="6" Padding="20" HorizontalAlignment="Center" Width="740" Margin="0,10,0,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtRootCaTitle" Text="Neue Root-CA Erstellen" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                            <Border Background="#F3F2F1" BorderBrush="#0078D4" BorderThickness="1,0,0,0" Padding="10" Margin="0,0,0,15">
                                <TextBlock Text="🔒 Die Root-CA ist der vertrauenswürdigste Anker deiner Infrastruktur und MUSS zwingend mit einem Passwort geschützt werden." 
                                           TextWrapping="Wrap" Foreground="#323130" FontSize="11"/>
                            </Border>

                            <TextBlock Text="Zertifikat-Inhaber (Subject)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,5,0,10"/>
                            
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Common Name (CN)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtRootCn" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Organization (O)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtRootOrg" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Organizational Unit (OU) (Optional)" Foreground="#605E5C"/>
                                    <TextBox x:Name="TxtRootOu" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Country Code (C)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtRootCountry" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="State / Province (ST) (Optional)" Foreground="#605E5C"/>
                                    <TextBox x:Name="TxtRootState" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Locality / City (L) (Optional)" Foreground="#605E5C"/>
                                    <TextBox x:Name="TxtRootLocality" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Dateiname &amp; Speicherung" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,10,0,10"/>
                            <StackPanel Margin="0,0,0,5">
                                <TextBlock Text="Dateibasisname" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtRootBaseFilename" Padding="4" Margin="0,2,0,4"/>
                                <TextBlock Text="Name der Ausgabedateien ohne Endung (z.B. RootCA -> RootCA.crt, RootCA.key)" FontSize="10" Foreground="#605E5C"/>
                            </StackPanel>

                            <TextBlock Text="Passwort-Schutz (Erforderlich)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,10,0,10"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="CA-Passwort" FontWeight="SemiBold"/>
                                    <PasswordBox x:Name="PwdRootPass" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Passwort wiederholen" FontWeight="SemiBold"/>
                                    <PasswordBox x:Name="PwdRootPassConfirm" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Kryptographie &amp; X.509 Extensions" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,10,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Key Algorithm" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbRootAlgorithm" SelectedIndex="0" Padding="4" Margin="0,2,0,8">
                                        <ComboBoxItem Content="RSA"/>
                                        <ComboBoxItem Content="ECDSA"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                    <TextBlock Text="Key Length" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbRootKeyLength" SelectedIndex="1" Padding="4" Margin="0,2,0,8">
                                        <ComboBoxItem Content="2048"/>
                                        <ComboBoxItem Content="4096"/>
                                        <ComboBoxItem Content="8192"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                    <TextBlock Text="Gültigkeit (Tage)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtRootDays" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,0,0,15">
                                <CheckBox x:Name="ChkRootKeyCertSign" Content="Key Usage: Certificate Sign (keyCertSign)" IsChecked="True" IsEnabled="False" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkRootCrlSign" Content="Key Usage: CRL Sign (cRLSign)" IsChecked="True" IsEnabled="False" Margin="0,0,15,5"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="BtnCancelRootCA" Content="Abbrechen" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="BtnSaveRootCA" Content="🔐 Root-CA Erstellen"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: INTERMEDIATE-CA ANLEGEN -->
            <TabItem x:Name="TabCreateIntermediate">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="White" CornerRadius="6" Padding="20" HorizontalAlignment="Center" Width="740" Margin="0,10,0,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtInterCaTitle" Text="Neue Intermediate-CA Erstellen" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                            
                            <Border x:Name="PanelNoRootForInterWarning" Background="#FDE8E8" BorderBrush="#D13438" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15" Visibility="Collapsed">
                                <TextBlock Text="⚠️ Keine aktive Root-CA gefunden! Eine Intermediate-CA muss von einer bestehenden Root-CA signiert werden." 
                                           TextWrapping="Wrap" Foreground="#D13438" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                            
                            <Border Background="#F3F2F1" BorderBrush="#0078D4" BorderThickness="1,0,0,0" Padding="10" Margin="0,0,0,15">
                                <TextBlock Text="ℹ Eine Intermediate-CA wird von der Root-CA signiert. Im Alltag werden Service-Zertifikate ausschließlich von ihr ausgestellt." 
                                           TextWrapping="Wrap" Foreground="#323130" FontSize="11"/>
                            </Border>

                            <TextBlock Text="Zertifikat-Inhaber (Subject)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,5,0,10"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Common Name (CN)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtInterCn" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Organization (O)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtInterOrg" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Dateiname &amp; Speicherung" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,10,0,10"/>
                            <StackPanel Margin="0,0,0,5">
                                <TextBlock Text="Dateibasisname" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtInterBaseFilename" Padding="4" Margin="0,2,0,4"/>
                                <TextBlock Text="Name der Ausgabedateien ohne Endung (z.B. IntermediateCA -> IntermediateCA.crt, IntermediateCA.key)" FontSize="10" Foreground="#605E5C"/>
                            </StackPanel>

                            <TextBlock Text="Passwort-Schutz (Optional)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,10,0,5"/>
                            <Border Background="#EFF6FC" BorderBrush="#0078D4" BorderThickness="1" Padding="10" CornerRadius="4" Margin="0,0,0,10">
                                <TextBlock Text="💡 Ohne Passwort: Erlaubt vollautomatische Ausstellung ohne Passwortabfragen." 
                                           TextWrapping="Wrap" FontSize="11" Foreground="#323130"/>
                            </Border>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Passwort (Leer = Passwortlos)" Foreground="#605E5C"/>
                                    <PasswordBox x:Name="PwdInterPass" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Passwort wiederholen" Foreground="#605E5C"/>
                                    <PasswordBox x:Name="PwdInterPassConfirm" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Kryptographie &amp; RFC 5280 Constraints" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,10,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Key Algorithm" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbInterAlgorithm" SelectedIndex="0" Padding="4" Margin="0,2,0,8">
                                        <ComboBoxItem Content="RSA"/>
                                        <ComboBoxItem Content="ECDSA"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                    <TextBlock Text="Key Length" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbInterKeyLength" SelectedIndex="0" Padding="4" Margin="0,2,0,8">
                                        <ComboBoxItem Content="2048"/>
                                        <ComboBoxItem Content="4096"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="5,0,5,0">
                                    <TextBlock Text="Gültigkeit (Tage)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtInterDays" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="5,0,0,0">
                                    <TextBlock Text="Path Length (pathlen)" FontWeight="SemiBold" ToolTip="Maximale Anzahl untergeordneter CAs (0 = darf keine weiteren Unter-CAs ausstellen)"/>
                                    <TextBox x:Name="TxtInterPathLen" Text="0" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,0,0,15">
                                <CheckBox x:Name="ChkInterKeyCertSign" Content="Key Usage: Certificate Sign (keyCertSign)" IsChecked="True" IsEnabled="False" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkInterCrlSign" Content="Key Usage: CRL Sign (cRLSign)" IsChecked="True" IsEnabled="False" Margin="0,0,15,5"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="BtnCancelIntermediate" Content="Abbrechen" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="BtnSaveIntermediate" Content="🔑 Intermediate-CA Erstellen"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: NEUER SERVICE ANLEGEN -->
            <TabItem x:Name="TabNewService">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="White" CornerRadius="6" Padding="20" HorizontalAlignment="Center" Width="740" Margin="0,10,0,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="TxtServiceCaTitle" Text="Neues Service-Zertifikat Konfigurieren" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                            <Border x:Name="PanelNoCaWarning" Background="#FDE8E8" BorderBrush="#D13438" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15" Visibility="Collapsed">
                                <TextBlock Text="⚠️ Keine aktive CA gefunden! Es muss zuerst eine Root-CA angelegt werden." 
                                           TextWrapping="Wrap" Foreground="#D13438" FontWeight="SemiBold" FontSize="12"/>
                            </Border>

                            <TextBlock Text="Interne Bezeichnung" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,10"/>
                            <TextBlock Text="Anzeigename / Label" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtServiceDisplayName" Text="Proxmox Node 01" Padding="4" Margin="0,2,0,15"/>

                            <TextBlock Text="Zertifikat-Inhaber (Subject)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,5,0,10"/>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Common Name (CN / Primary FQDN)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtServiceCn" Text="pve01.home.internal" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                    <TextBlock Text="OU (Optional)" Foreground="#605E5C"/>
                                    <TextBox x:Name="TxtServiceOu" Text="service certificate" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Subject Alternative Names (SANs - RFC 5280 / RFC 2818)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,10,0,10"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="DNS Namen (DNS: kommagetrennt)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtServiceDnsSANs" Text="pve01.home.internal, pve.local" Padding="4" Margin="0,2,0,4"/>
                                    <TextBlock Text="z.B. server.home.internal, *.home.internal" FontSize="10" Foreground="#605E5C"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="IP-Adressen (IP: kommagetrennt)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtServiceIpSANs" Text="192.168.1.10" Padding="4" Margin="0,2,0,4"/>
                                    <TextBlock Text="z.B. 192.168.1.10, 10.0.0.1" FontSize="10" Foreground="#605E5C"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Verwendungszweck (Extended Key Usage &amp; Key Usage)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,5,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Extended Key Usage (EKU)" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbServiceEku" SelectedIndex="0" Padding="4" Margin="0,2,0,8">
                                        <ComboBoxItem Content="TLS Web Server Authentication (serverAuth)"/>
                                        <ComboBoxItem Content="TLS Web Client Authentication (clientAuth)"/>
                                        <ComboBoxItem Content="Server &amp; Client Authentication (Beides)"/>
                                        <ComboBoxItem Content="Code Signing (codeSigning)"/>
                                        <ComboBoxItem Content="Kein EKU (Nur Key Usage)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                    <TextBlock Text="Key Algorithm" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbServiceAlgorithm" SelectedIndex="0" Padding="4" Margin="0,2,0,8">
                                        <ComboBoxItem Content="RSA"/>
                                        <ComboBoxItem Content="ECDSA"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                    <TextBlock Text="Key Length" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="CmbServiceKeyLength" SelectedIndex="0" Padding="4" Margin="0,2,0,8">
                                        <ComboBoxItem Content="2048"/>
                                        <ComboBoxItem Content="4096"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Key Usage Flags (KU)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <WrapPanel Margin="0,0,0,15">
                                <CheckBox x:Name="ChkKuDigitalSignature" Content="Digital Signature" IsChecked="True" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkKuKeyEncipherment" Content="Key Encipherment (RSA)" IsChecked="True" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkKuDataEncipherment" Content="Data Encipherment" IsChecked="False" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkKuKeyAgreement" Content="Key Agreement (ECDH)" IsChecked="False" Margin="0,0,15,5"/>
                            </WrapPanel>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Gültigkeit (Tage)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TxtServiceDays" Padding="4" Margin="0,2,0,8"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Export-Dateien Generieren" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,5,0,10"/>
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkExportPfx" Content="PFX (.pfx)" IsChecked="False" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkExportCrt" Content="Zertifikat (.crt)" IsChecked="True" IsEnabled="False" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkExportKey" Content="Private Key (.key)" IsChecked="True" IsEnabled="False" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkExportPemOnly" Content="PEM Zertifikat (.pem)" IsChecked="False" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkExportPemFull" Content="PEM inkl Key (.full.pem)" IsChecked="False" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkExportChain" Content="Chain (chain.crt)" IsChecked="False" Margin="0,0,15,5"/>
                                <CheckBox x:Name="ChkExportFullChain" Content="Fullchain (fullchain.crt)" IsChecked="True" Margin="0,0,15,5"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCancelNewService" Content="Abbrechen" Style="{StaticResource SecondaryButton}"/>
                                <Button x:Name="BtnSaveNewService" Content="💾 Speichern &amp; Erzeugen"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: CONFIG EDITOR / EXPORT / IMPORT -->
            <TabItem x:Name="TabConfig">
                <Border Background="White" CornerRadius="6" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Erweiterte Einstellungen (config.yaml)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBox x:Name="TxtConfigEditor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" 
                                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Margin="0,0,0,10"/>

                        <Border Grid.Row="2" Background="#FFF8E5" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                            <TextBlock x:Name="TxtConfigNotice" TextWrapping="Wrap" FontSize="11" Foreground="#555555"
                                       Text="ℹ️ Die Konfiguration dient hier als Ansicht. Ein Import ist nur bei einer Neuinstallation möglich, bevor eine Root-CA angelegt wurde." />
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnBackFromConfig" Content="Zurück zum Dashboard" Style="{StaticResource SecondaryButton}"/>
                            <Button x:Name="BtnImportConfig" Content="📥 Config Importieren" Style="{StaticResource SecondaryButton}"/>
                            <Button x:Name="BtnExportConfig" Content="📤 Config Exportieren"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 6: HILFE & PKI-DOKUMENTATION -->
            <TabItem x:Name="TabHelp">
                <Border Background="White" CornerRadius="6" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="PKI-Handbuch &amp; Erklärungen" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                            <StackPanel>
                                <!-- Sektion 1 -->
                                <TextBlock Text="1. Root-CA (Das Fundament)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,5"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="Die Root-CA ist der vertrauenswürdige Anker deiner gesamten PKI. Sie stellt sich selbst aus (Self-Signed) und sollte extrem sicher aufbewahrt werden (im Idealfall offline).&#x0a;• RootCA.crt: Enthält den öffentlichen Schlüssel. Muss auf allen Clients/Geräten im Heimnetz als vertrauenswürdige Stammzertifizierungsstelle importiert werden.&#x0a;• RootCA.key: Der geheime Schlüssel. Zum Signieren der Unter-CAs. Niemals auf öffentlich erreichbaren Servern speichern!&#x0a;• RootCA.pfx: Bundle aus Zertifikat und privatem Schlüssel für Backups oder den Import in Admin-Tools.&#x0a;• RootCA.srl: Kleine Textdatei, die intern von OpenSSL zur Verwaltung der Seriennummern genutzt wird."/>

                                <!-- Sektion 2 -->
                                <TextBlock Text="2. Intermediate-CA (Die Arbeitstier-CA)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,10,0,5"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="Aus Sicherheitsgründen signiert die Root-CA selten direkte Server-Zertifikate. Stattdessen wird eine Intermediate-CA eingesetzt. Wird diese kompromittiert, kann sie widerrufen werden, ohne die Root-CA neu zu erstellen.&#x0a;• IntermediateCA.crt: Das Zertifikat der Zwischen-CA, signiert von der Root-CA.&#x0a;• IntermediateCA.key: Der private Schlüssel, den du im Alltag nutzt, um neue Service-Zertifikate auszustellen.&#x0a;• IntermediateCA.pfx / .srl: Container bzw. Seriennummern-Verwaltung analog zur Root-CA."/>

                                <!-- Sektion 3 -->
                                <TextBlock Text="3. Service-Zertifikate (z.B. Proxmox, Webdienste)" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,10,0,5"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="Diese Zertifikate werden von der Intermediate-CA (oder Root-CA) für konkrete Server in deinem Netzwerk ausgestellt.&#x0a;• .key: Der private Schlüssel des Servers (muss sicher auf dem Zielserver verbleiben).&#x0a;• .crt: Das reine End-Entity-Zertifikat.&#x0a;• .fullchain.crt: Die vollständige Kette (Server-Zertifikat + CA-Kette). Dies ist die wichtigste Datei für Webserver, Reverse Proxies oder Proxmox, um Browser-Warnungen zu verhindern.&#x0a;• .pfx: Kombinierter Container für Dienste, die z. B. unter Windows ein PFX-Format voraussetzen."/>

                                <!-- Sektion 4 (NEU: Das Zusammenspiel im Alltag) -->
                                <TextBlock Text="4. Zusammenspiel &amp; Funktionsweise im Alltag" FontSize="14" FontWeight="Bold" Foreground="#0078D4" Margin="0,10,0,5"/>
                                <Border Background="#F3F2F1" BorderBrush="#0078D4" BorderThickness="1,0,0,0" Padding="12" Margin="0,0,0,10">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#323130" Text="1. Vertrauensbasis: Die RootCA.crt wird einmalig auf deinen Clients, PCs oder Smartphones als vertrauenswürdige Stammzertifizierungsstelle hinterlegt.&#x0a;&#x0a;2. Kette beim Aufruf: Wenn du eine HTTPS-Seite aufrufst (z. B. https://pve01.home.internal), liefert der Server dem Browser seine fullchain.crt (Server-Zertifikat + Intermediate-CA Zertifikat) sowie seinen privaten Schlüssel (.key) zum Nachweis der Identität.&#x0a;&#x0a;3. Browser-Prüfung: Der Browser prüft automatisch:&#x0a;   • Vertraue ich der Intermediate-CA? (Ja, weil sie von der Root-CA signiert wurde)&#x0a;   • Vertraue ich der Root-CA? (Ja, liegt lokal im Stammzertifikatsspeicher)&#x0a;   ➔ Ergebnis: Die Verbindung ist vertrauenswürdig (Schloss-Symbol ist grün).&#x0a;&#x0a;4. Ausstellung neuer Zertifikate: Neue Server-Zertifikate erzeugst du im Alltag über diese GUI bequem mit dem IntermediateCA.key. Die Root-CA bleibt dabei sicher und unangetastet geschützt."/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnBackFromHelp" Content="Zurück zum Dashboard" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- STATUSZEILE MIT EINSTELLUNGEN- & HILFE-BUTTON -->
        <Border Grid.Row="1" Background="#E1DFDD" Padding="8,2" Margin="0,8,0,0" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Bereit." FontSize="12" Foreground="#323130" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnOpenHelp" Content="❓ Hilfe" 
                            Style="{StaticResource SecondaryButton}" FontSize="11" Padding="6,2" Margin="0,0,4,0"/>
                    <Button x:Name="BtnOpenConfig" Grid.Column="1" Content="⚙ Einstellungen" 
                            Style="{StaticResource SecondaryButton}" FontSize="11" Padding="6,2" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>